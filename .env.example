# ===== FormFlow 本地配置（.env.example，复制为 .env 后填写，.env 永不提交）=====
# 大模型网关（OpenAI 兼容）
FORMFLOW_LLM_BASE_URL=https://aigw.saurlax.com/v1
FORMFLOW_LLM_API_KEY=sk-在此填入你的密钥
FORMFLOW_LLM_MODEL=glm-5.3
# 主模型不可用（超时/限流/5xx）时的降级模型；留空则不降级。
# 背景：glm-5.3 经当前网关单次调用可达 6 分钟且不稳定，可用快模型（如 step-3.7-flash）兜底。
FORMFLOW_LLM_FALLBACK_MODEL=step-3.7-flash

# 数据库（默认 SQLite，文件位于 data/ 下，已 gitignore）
FORMFLOW_DATABASE_URL=sqlite:///./data/formflow.db

# 私有文件存储根目录（已 gitignore）
FORMFLOW_STORAGE_DIR=./data/storage

# 审核预算上限（按方案：每次审核需有页数/OCR/调用/重试/费用预算）
FORMFLOW_MAX_PAGES_PER_RUN=40
FORMFLOW_MAX_LLM_CALLS_PER_RUN=30
# 单次网关调用等待上限（秒）。有降级模型时，主模型尝试上限收敛为 min(本值, 90)，
# 失败即用降级模型重试；无降级模型时本值即主模型上限（glm-5.3 建议 >= 300）。
FORMFLOW_LLM_TIMEOUT_SECONDS=300
# 内部重试次数（有降级模型时主模型不重试，直接兜底）
FORMFLOW_LLM_MAX_RETRIES=2
