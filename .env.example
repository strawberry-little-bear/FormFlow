# ===== FormFlow 配置（复制为 .env 后填写，.env 永不提交）=====
# development/demo 允许本地注册；公网部署请改为 production，并关闭公开注册。
FORMFLOW_ENV=development
FORMFLOW_ALLOW_REGISTRATION=true
# 大模型网关（OpenAI 兼容）；必须由部署者主动填写，不使用仓库默认 provider。
FORMFLOW_LLM_BASE_URL=https://your-provider.example/v1
FORMFLOW_LLM_API_KEY=
# Docker Compose 推荐把密钥放在仓库外的 .formflow_llm_api_key 文件中；
# 该文件只读挂载到容器，不会出现在 compose config 输出里。
FORMFLOW_LLM_MODEL=your-model
# auto：优先直传原始文件，模型/网关不支持时回退到文本解析和 OCR；
# text：只使用服务器文本层；ocr：只使用服务器解析/OCR；direct：不支持直传时直接报未完成。
FORMFLOW_LLM_INPUT_MODE=auto
# 单个文件允许发送给外部模型的大小上限（字节）。超限会走本地降级。
FORMFLOW_LLM_MAX_FILE_BYTES=20971520
# 主模型不可用时的降级模型；留空则不降级。
FORMFLOW_LLM_FALLBACK_MODEL=

# 数据库（默认 SQLite，文件位于 data/ 下，已 gitignore）
FORMFLOW_DATABASE_URL=sqlite:///./data/formflow.db

# 私有文件存储根目录（已 gitignore）
FORMFLOW_STORAGE_DIR=./data/storage
# Worker 心跳文件；Compose 会用同一配置检查 Worker 是否仍在运行。
FORMFLOW_WORKER_HEARTBEAT_FILE=./data/storage/.worker-heartbeat

# 审核预算上限（按方案：每次审核需有页数/OCR/调用/重试/费用预算）
FORMFLOW_MAX_PAGES_PER_RUN=40
FORMFLOW_MAX_LLM_CALLS_PER_RUN=30
# 单次网关调用等待上限（秒）。有降级模型时，主模型尝试上限收敛为 min(本值, 90)，
# 失败即用降级模型重试；无降级模型时本值就是主模型上限。
FORMFLOW_LLM_TIMEOUT_SECONDS=300
# 内部重试次数（有降级模型时主模型不重试，直接兜底）
FORMFLOW_LLM_MAX_RETRIES=2

# 组织者登录会话有效期（秒），默认 7 天；公网部署可按账号策略缩短。
FORMFLOW_SESSION_TTL_SECONDS=604800

# 解析预算（第 16 节：限制页数与解析时间，超限页记未读 -> 语义 unknown）
FORMFLOW_MAX_OCR_PAGES_PER_FILE=20
FORMFLOW_OCR_TIME_BUDGET_SECONDS=120
